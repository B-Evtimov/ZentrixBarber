@model AdminTreatmentIndexViewModel
@{
    ViewData["Title"] = "Delete Service";
    bool canDelete = Model.AppointmentsCount == 0;
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white fw-semibold">
                Are you sure you want to delete this service?
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("F2") €</dd>

                    <dt class="col-sm-4">Duration</dt>
                    <dd class="col-sm-8">@Model.DurationMinutes min</dd>

                    <dt class="col-sm-4">Offered by</dt>
                    <dd class="col-sm-8">@Model.BarbersCount barber(s)</dd>
                </dl>

                @if (canDelete)
                {
                    <p class="text-danger mt-3 mb-0">This action cannot be undone.</p>
                }
                else
                {
                    <p class="text-warning mt-3 mb-0">
                        This service has @Model.AppointmentsCount booked appointment(s) and cannot be deleted.
                    </p>
                }
            </div>
            <div class="card-footer d-flex gap-2">
                @if (canDelete)
                {
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger">Yes, delete it</button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-outline-light">Go back</a>
            </div>
        </div>
    </div>
</div>