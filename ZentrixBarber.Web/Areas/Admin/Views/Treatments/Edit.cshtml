@model TreatmentFormViewModel
@{
    ViewData["Title"] = "Edit Service";
    string? treatmentId = ViewContext.RouteData.Values["id"]?.ToString();
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@treatmentId" method="post">
            <partial name="_TreatmentFormFields" model="Model" />

            <button type="submit" class="btn btn-accent">Save changes</button>
            <a asp-action="Index" class="btn btn-outline-light">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}