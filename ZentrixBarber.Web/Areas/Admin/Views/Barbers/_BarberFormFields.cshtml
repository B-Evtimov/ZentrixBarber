@model BarberFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="FullName" class="form-label"></label>
    <input asp-for="FullName" class="form-control" />
    <span asp-validation-for="FullName" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="YearsOfExperience" class="form-label"></label>
        <input asp-for="YearsOfExperience" class="form-control" />
        <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
    </div>
    <div class="col-md-8 mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" placeholder="https://" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Bio" class="form-label"></label>
    <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Bio" class="text-danger"></span>
</div>

<div class="mb-4">
    <label class="form-label">Services this barber offers</label>
    <div class="row row-cols-1 row-cols-md-2 g-2">
        @foreach (var treatment in Model.Treatments)
        {
            bool isChecked = Model.SelectedTreatmentIds.Contains(int.Parse(treatment.Value));

            <div class="col">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedTreatmentIds"
                           value="@treatment.Value" id="treatment-@treatment.Value" checked="@isChecked" />
                    <label class="form-check-label" for="treatment-@treatment.Value">@treatment.Text</label>
                </div>
            </div>
        }
    </div>
</div>