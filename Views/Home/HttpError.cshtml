@model int
@{
    bool isNotFound = Model == StatusCodes.Status404NotFound;
    ViewData["Title"] = isNotFound ? "Page not found" : "Something went wrong";
}

<div class="text-center py-5">
    <div class="zb-error-code">@Model</div>
    <h1 class="mt-3">@ViewData["Title"]</h1>

    @if (isNotFound)
    {
        <p class="text-muted">The page you are looking for does not exist or has been moved.</p>
    }
    else
    {
        <p class="text-muted">The request could not be completed. Please try again.</p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-accent mt-3">Back to home</a>
</div>