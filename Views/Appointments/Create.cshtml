@model AppointmentFormViewModel

@{
    ViewData["Title"] = "Book an Appointment";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Create" method="post">
            <partial name="_AppointmentFormFields" model="Model" />

            <button type="submit" class="btn btn-accent">Book appointment</button>
            <a asp-controller="Treatments" asp-action="Index" class="btn btn-outline-light">View prices</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}