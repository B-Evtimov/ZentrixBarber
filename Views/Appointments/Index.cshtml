@model IEnumerable<AppointmentIndexViewModel>

@{
    ViewData["Title"] = "Upcoming Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-dark">Book an appointment</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">There are no upcoming appointments.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date &amp; time</th>
                    <th>Client</th>
                    <th>Barber</th>
                    <th>Service</th>
                    <th>Price</th>
                    <th>Status</th>

                    <th class="text-end">Actions</th>


                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model)
                {
                    string badgeClass = appointment.Status switch
                    {
                        AppointmentStatus.Pending => "bg-warning text-dark",
                        AppointmentStatus.Confirmed => "bg-success",
                        AppointmentStatus.Completed => "bg-secondary",
                        AppointmentStatus.Cancelled => "bg-danger",
                        _ => "bg-light text-dark"
                    };

                    <tr>
                        <td>
                            @appointment.StartTime.ToString("dd.MM.yyyy HH:mm")
                            <div class="small text-muted">@appointment.DurationMinutes min</div>
                        </td>
                        <td>
                            @appointment.ClientName
                            <div class="small text-muted">@appointment.ClientPhone</div>
                        </td>
                        <td>@appointment.BarberName</td>
                        <td>@appointment.TreatmentName</td>
                        <td>@appointment.Price.ToString("F2") €</td>
                        <td><span class="badge @badgeClass">@appointment.Status</span></td>

                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@appointment.Id" class="btn btn-sm btn-outline-dark">Details</a>
                            @if (appointment.Status == AppointmentStatus.Pending || appointment.Status == AppointmentStatus.Confirmed)
                            {
                                <a asp-action="Edit" asp-route-id="@appointment.Id" class="btn btn-sm btn-dark">Edit</a>
                            }
                        </td>


                    </tr>
                }
            </tbody>
        </table>
    </div>
}