@model AppointmentDetailsViewModel

@{
    ViewData["Title"] = "Delete Appointment";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white fw-semibold">
                Are you sure you want to delete this appointment? 
            </div>


            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Client</dt>
                    <dd class="col-sm-8">@Model.ClientName (@Model.ClientPhone)</dd>

                    <dt class="col-sm-4">Date and time</dt>
                    <dd class="col-sm-8">@Model.StartTime.ToString("dd.MM.yyyy HH:mm") - @Model.EndTime.ToString("HH:mm")</dd>

                    <dt class="col-sm-4">Barber</dt>
                    <dd class="col-sm-8">@Model.BarberName</dd>

                    <dt class="col-sm-4">Service</dt>
                    <dd class="col-sm-8">@Model.TreatmentName</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>



                <p class="text-danger mt-3 mb-0">This action cannot be undone.</p>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger">Yes, delete it</button>
                </form>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">No, go back</a>
            </div>
        </div>
    </div>
</div>
