@model AppointmentFormViewModel

@{
    ViewData["Title"] = "Edit Appointment";
    string? appointmentId = ViewContext.RouteData.Values["id"]?.ToString();
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@appointmentId" method="post">
            <partial name="_AppointmentFormFields" model="Model" />

            <button type="submit" class="btn btn-accent">Save changes</button>
            <a asp-action="Details" asp-route-id="@appointmentId" class="btn btn-outline-light">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}