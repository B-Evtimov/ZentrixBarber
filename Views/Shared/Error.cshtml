@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <div class="zb-error-code">500</div>
    <h1 class="mt-3">Something went wrong on our side</h1>
    <p class="text-muted">An unexpected error occurred. Please try again in a few moments.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-accent mt-3">Back to home</a>
</div>