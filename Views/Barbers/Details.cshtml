@model BarberDetailsViewModel

@{
    ViewData["Title"] = Model.FullName;
}

<h1 class="mb-2">@Model.FullName</h1>
<p class="text-muted">@Model.YearsOfExperience years of experience</p>

@if (string.IsNullOrWhiteSpace(Model.Bio))
{
    <p class="text-muted fst-italic">No bio yet.</p>
}

else
{
    <p class="lead">@Model.Bio</p>
}

<h2 class="mt-4">Services</h2>

@if (!Model.Treatments.Any())
{
    <p class="text-muted">This barber does not offer any services yet.</p>
}


else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Service</th>
                <th>Duration</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var treatment in Model.Treatments)
            {
                <tr>
                    <td>@treatment.Name</td>
                    <td>@treatment.DurationMinutes min</td>
                    <td>@treatment.Price.ToString("F2") €</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-outline-secondary">Back to all barbers</a>
<a asp-controller="Appointments" asp-action="Create" asp-route-barberId="@Model.Id" class="btn btn-dark">Book with @Model.FullName</a>